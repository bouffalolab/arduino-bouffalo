+/* Bridge diagnostic only: preserve allocator and error/cleanup semantics. */
+extern void bridge_mbedtls_alloc_failed(const void *ssl, unsigned stage,
+                                        size_t requested) __attribute__((weak));
+
+static void bridge_ssl_alloc_failed(const mbedtls_ssl_context *ssl,
+                                    unsigned stage, size_t requested)
+{
+    if (bridge_mbedtls_alloc_failed != NULL) {
+        bridge_mbedtls_alloc_failed(ssl, stage, requested);
+    }
+}
