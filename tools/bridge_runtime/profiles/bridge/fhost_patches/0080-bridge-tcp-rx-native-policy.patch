 #define BRIDGE_TCP_RECEIVE_WINDOW() bridge_tcp_receive_window_limit()
 
+/* Optional core-lock-owned receive policy. The immutable table must provide
+ * every callback. With no table, the fixed diagnostic/stock window is kept.
+ * open runs after initialization and before any SYN; close runs at tcp_free,
+ * including listen conversion, reaping, abort and failed-open cleanup.
+ * received counts unique in-order sequence bytes, including FIN. recved owns
+ * replenishment entirely; it must never retract accepted/announced credit. */
+struct bridge_tcp_rx_policy_hooks {
+  int (*open)(struct tcp_pcb *);
+  void (*close)(struct tcp_pcb *);
+  unsigned (*window)(const struct tcp_pcb *);
+  void (*received)(struct tcp_pcb *, unsigned);
+  void (*recved)(struct tcp_pcb *, unsigned);
+  void (*poll)(void);
+};
+extern const struct bridge_tcp_rx_policy_hooks bridge_tcp_rx_policy
+    __attribute__((weak));
+static inline tcpwnd_size_t bridge_tcp_pcb_receive_window(const struct tcp_pcb *pcb)
+{
+  if (&bridge_tcp_rx_policy) {
+    unsigned value = bridge_tcp_rx_policy.window(pcb);
+    return value <= TCP_WND ? (tcpwnd_size_t)value : 0;
+  }
+  return BRIDGE_TCP_RECEIVE_WINDOW();
+}
+#define BRIDGE_TCP_PCB_WINDOW(pcb) bridge_tcp_pcb_receive_window(pcb)
+
 #if LWIP_WND_SCALE
 #define RCV_WND_SCALE(pcb, wnd) (((wnd) >> (pcb)->rcv_scale))
 #define SND_WND_SCALE(pcb, wnd) (((wnd) << (pcb)->snd_scale))
 #define TCPWND16(x)             ((u16_t)LWIP_MIN((x), 0xFFFF))
-#define TCP_WND_MAX(pcb)        ((tcpwnd_size_t)(((pcb)->flags & TF_WND_SCALE) ? BRIDGE_TCP_RECEIVE_WINDOW() : TCPWND16(BRIDGE_TCP_RECEIVE_WINDOW())))
+#define TCP_WND_MAX(pcb)        ((tcpwnd_size_t)(((pcb)->flags & TF_WND_SCALE) ? BRIDGE_TCP_PCB_WINDOW(pcb) : TCPWND16(BRIDGE_TCP_PCB_WINDOW(pcb))))
 #else
 #define RCV_WND_SCALE(pcb, wnd) (wnd)
 #define SND_WND_SCALE(pcb, wnd) (wnd)
 #define TCPWND16(x)             (x)
-#define TCP_WND_MAX(pcb)        BRIDGE_TCP_RECEIVE_WINDOW()
