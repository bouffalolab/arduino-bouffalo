+ * allocate, print, or change scheduler/controller state (may run in IRQ context).
+ * Event 1=start, 2=first synchronization, 3=cleanup. Clock is in half-slots.
+ */
+extern void bridge_ble_link_observe(unsigned event, unsigned clock,
+    unsigned link, unsigned role, unsigned interval, unsigned events,
+    unsigned flags, unsigned reason) __attribute__((weak));
 
