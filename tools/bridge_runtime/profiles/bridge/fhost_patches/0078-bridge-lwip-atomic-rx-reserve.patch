+extern void *bridge_mem_malloc_reserved(mem_size_t, unsigned, int *);
+struct pbuf *
+bridge_pbuf_alloc_reserved(u16_t length, unsigned reserve, int *denied)
+{
+  struct pbuf *p;
+  const mem_size_t alloc_len = (mem_size_t)(LWIP_MEM_ALIGN_SIZE(SIZEOF_STRUCT_PBUF) + LWIP_MEM_ALIGN_SIZE(length));
+  if (denied) *denied = 0;
+  if (alloc_len < LWIP_MEM_ALIGN_SIZE(length)) return NULL;
+  p = (struct pbuf *)bridge_mem_malloc_reserved(alloc_len, reserve, denied);
+  if (!p) return NULL;
+  pbuf_init_alloced_pbuf(p, LWIP_MEM_ALIGN((void *)((u8_t *)p + SIZEOF_STRUCT_PBUF)),
+                       length, length, PBUF_RAM, 0);
+  return p;
+}
