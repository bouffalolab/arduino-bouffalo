--- a/components/net/lwip/lwip/src/core/tcp_in.c
+++ b/components/net/lwip/lwip/src/core/tcp_in.c
@@ -119,6 +119,14 @@
  * @param p received TCP segment to process (p->payload pointing to the TCP header)
  * @param inp network interface on which this segment was received
  */
+/* Passive events for validated SYNs, no address/payload retention. */
+extern void bridge_tcp_listen_observer(unsigned event, unsigned port)
+    __attribute__((weak));
+#define BRIDGE_TCP_LISTEN_OBSERVE(event) do { \
+  if (bridge_tcp_listen_observer && (flags & (TCP_SYN | TCP_ACK)) == TCP_SYN) \
+    bridge_tcp_listen_observer((event), tcphdr->dest); \
+} while (0)
+
 void
 tcp_input(struct pbuf *p, struct netif *inp)
 {
@@ -252,6 +260,8 @@
       goto dropped;
     }
   }
+
+  BRIDGE_TCP_LISTEN_OBSERVE(0);
 
   /* Demultiplex an incoming segment. First, we check if it is destined
      for an active connection. */
@@ -395,6 +405,7 @@
                                      tcphdr_opt1len, tcphdr_opt2, p) == ERR_OK)
 #endif
       {
+        BRIDGE_TCP_LISTEN_OBSERVE(1);
         tcp_listen_input(lpcb);
       }
       pbuf_free(p);
@@ -600,6 +611,7 @@
       pbuf_free(p);
     }
 #else
+    BRIDGE_TCP_LISTEN_OBSERVE(5);
     /* If no matching PCB was found, send a TCP RST (reset) to the
        sender. */
     LWIP_DEBUGF(TCP_RST_DEBUG, ("tcp_input: no PCB match found, resetting.\n"));
@@ -683,6 +695,7 @@
     LWIP_DEBUGF(TCP_DEBUG, ("TCP connection request %"U16_F" -> %"U16_F".\n", tcphdr->src, tcphdr->dest));
 #if TCP_LISTEN_BACKLOG
     if (pcb->accepts_pending >= pcb->backlog) {
+      BRIDGE_TCP_LISTEN_OBSERVE(2);
       LWIP_DEBUGF(TCP_DEBUG, ("tcp_listen_input: listen backlog exceeded for port %"U16_F"\n", tcphdr->dest));
       return;
     }
@@ -693,6 +706,7 @@
        SYN at a time when we have more memory available. */
     if (npcb == NULL) {
       err_t err;
+      BRIDGE_TCP_LISTEN_OBSERVE(3);
       LWIP_DEBUGF(TCP_DEBUG, ("tcp_listen_input: could not allocate PCB\n"));
       TCP_STATS_INC(tcp.memerr);
       TCP_EVENT_ACCEPT(pcb, NULL, pcb->callback_arg, ERR_MEM, err);
@@ -749,6 +763,7 @@
     /* Send a SYN|ACK together with the MSS option. */
     rc = tcp_enqueue_flags(npcb, TCP_SYN | TCP_ACK);
     if (rc != ERR_OK) {
+      BRIDGE_TCP_LISTEN_OBSERVE(4);
       tcp_abandon(npcb, 0);
       return;
     }
