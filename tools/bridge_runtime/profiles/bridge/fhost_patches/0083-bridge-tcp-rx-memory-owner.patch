--- a/components/net/lwip/lwip/src/core/mem.c
+++ b/components/net/lwip/lwip/src/core/mem.c
@@ -621,6 +621,33 @@
  * @param rmem is the data portion of a struct mem as returned by a previous
  *             call to mem_malloc()
  */
+/* Exact full native charge for a live allocation base. The caller holds a
+ * pbuf reference across query/bind, so the allocation cannot be finally freed.
+ * Walk actual block boundaries: an aligned interior pointer is not a base.
+ * No allocation, observer, logging or TCP core lock acquisition is performed. */
+unsigned
+bridge_lwip_mem_charge(const void *allocation)
+{
+  unsigned charge = 0;
+  mem_size_t offset = 0;
+  LWIP_MEM_FREE_DECL_PROTECT();
+  if (allocation == NULL) return 0;
+  LWIP_MEM_FREE_PROTECT();
+  while (offset <= MEM_SIZE_ALIGNED - SIZEOF_STRUCT_MEM) {
+    struct mem *block = ptr_to_mem(offset);
+    mem_size_t next = block->next;
+    if (next < offset + SIZEOF_STRUCT_MEM || next > MEM_SIZE_ALIGNED ||
+        (next & (MEM_ALIGNMENT - 1)) || block->used > 1) break;
+    if ((const u8_t *)allocation == ram + offset + SIZEOF_STRUCT_MEM + MEM_SANITY_OFFSET) {
+      if (block->used && mem_link_valid(block)) charge = next - offset;
+      break;
+    }
+    offset = next;
+  }
+  LWIP_MEM_FREE_UNPROTECT();
+  return charge;
+}
+
 void
 mem_free(void *rmem)
 {
