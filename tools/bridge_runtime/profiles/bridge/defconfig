-include $(BL_SDK_BASE)/examples/wifi/defconfig

CONFIG_IPV6                  =y

# Persist bridge state in the SDK's LittleFS/EasyFlash implementation.
CONFIG_BFLB_MTD              =y
CONFIG_PARTITION             =y
CONFIG_LITTLEFS              =y
CONFIG_LITTLEFS_KV_EASYFLASH =y

# Enable the Bouffalo A/B firmware updater.  The bridge exposes a small
# sequential AT/raw-payload frontend around this SDK service; RA4M1 OTA keeps
# its separate RA4_OTA cache and BOSSA path.
CONFIG_FOTA                  =y
CONFIG_FOTA_NO_SHELL         =y

# mbedTLS allocates independent input and output record buffers during
# mbedtls_ssl_setup(). Keep each at 2 KiB while the handshake parses
# certificates, then allow established bridge slots to compact their
# buffers after negotiating RFC 6066 maximum_fragment_length=1024.
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN = 2048
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH =y
CONFIG_MBEDTLS_USER_CONFIG_ENABLE  =y
CONFIG_MBEDTLS_USER_CONFIG_FILE    ="mbedtls_bridge_p256_config.h"

# The bridge needs a FreeRTOS USB device with CDC ACM and vendor HID.
CONFIG_BSP_USB                 =y
CONFIG_CHERRYUSB               =y
CONFIG_CHERRYUSB_DEVICE        =y
CONFIG_CHERRYUSB_DEVICE_CDC    =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM=y
CONFIG_CHERRYUSB_DEVICE_HID    =y

# Keep the Wi-Fi/BLE coexistence controller selected by the BL616CL SDK demo.
CONFIG_BLUETOOTH              =y
CONFIG_BT_SETTINGS            =y
CONFIG_BT_STACK_CLI           =n
CONFIG_BTBLECONTROLLER_LIB    =m2s1
CONFIG_BLE_USE_MAC2           =n

CONFIG_BFLB_LOG               =n
CONFIG_FREERTOS               =y
CONFIG_SHELL                  =n
CONFIG_RF                     =y
CONFIG_PEC_V2                 =n
CONFIG_MULTIMEDIA_VIDEO       =n
CONFIG_GCC_COMPILE_LTO        =n
CONFIG_TLSF                   =y
CONFIG_DEBUG                  =y
CONFIG_ROMAPI                 =y
CONFIG_LOG_LEVEL              =3
CONFIG_CONSOLE_UART_BAUDRATE  =2000000
# Route SDK printf/stdout through the BL616CL write-only UART on GPIO8.
# UART0 remains reserved for the RA4M1 user UART on GPIO34/35.
CONFIG_CONSOLE_WO             =y

# Retain AP+STA capability while reserving enough WRAM for SoftAP hostapd
# allocations. The matching SDK overlay only reduces RX reorder/BA capacity.
CONFIG_UNOR4_BRIDGE_RESOURCE_PROFILE =y

# WiFiS3 does not expose WPS. Keep it out of the bridge profile while the
# SoftAP/WPS initialization path is under hardware validation.
CONFIG_BRIDGE_DISABLE_WPS      =y
