+enum bridge_ap_command {
+    BRIDGE_AP_COMMAND_NONE = 0,
+    BRIDGE_AP_COMMAND_INTERFACE_ADD = 1,
+    BRIDGE_AP_COMMAND_INTERFACE_REMOVE = 2,
+    BRIDGE_AP_COMMAND_ADD_NETWORK = 3,
+    BRIDGE_AP_COMMAND_SET_SAE_PWE = 4,
+    BRIDGE_AP_COMMAND_SET_COUNTRY = 5,
+    BRIDGE_AP_COMMAND_SET_NON_PREF_CHAN = 6,
+    BRIDGE_AP_COMMAND_SET_NETWORK_KEY_MGMT = 7,
+    BRIDGE_AP_COMMAND_SET_NETWORK_MODE = 8,
+    BRIDGE_AP_COMMAND_SET_NETWORK_SSID = 9,
+    BRIDGE_AP_COMMAND_SET_NETWORK_PSK = 10,
+    BRIDGE_AP_COMMAND_SET_NETWORK_GENERIC = 11,
+    BRIDGE_AP_COMMAND_AP_SCAN = 12,
+    BRIDGE_AP_COMMAND_ENABLE_NETWORK = 13,
+    BRIDGE_AP_COMMAND_OTHER = 14,
+};
+
+static uint8_t bridge_ap_command_class(int fhost_vif_idx, const char *command)
+{
+    const char *setting;
+
+    if (fhost_vif_idx == FHOST_WPA_GLOBAL_VIF) {
+        if (strncmp(command, "INTERFACE_ADD wl2",
+                    sizeof("INTERFACE_ADD wl2") - 1) == 0)
+            return BRIDGE_AP_COMMAND_INTERFACE_ADD;
+        if (strncmp(command, "INTERFACE_REMOVE wl2",
+                    sizeof("INTERFACE_REMOVE wl2") - 1) == 0)
+            return BRIDGE_AP_COMMAND_INTERFACE_REMOVE;
+        return BRIDGE_AP_COMMAND_NONE;
+    }
+
+    if (fhost_vif_idx != MGMR_VIF_AP)
+        return BRIDGE_AP_COMMAND_NONE;
+
+    if (strcmp(command, "ADD_NETWORK") == 0)
+        return BRIDGE_AP_COMMAND_ADD_NETWORK;
+    if (strcmp(command, "SET sae_pwe 2") == 0)
+        return BRIDGE_AP_COMMAND_SET_SAE_PWE;
+    if (strncmp(command, "SET country ", sizeof("SET country ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_SET_COUNTRY;
+    if (strncmp(command, "SET non_pref_chan ",
+                sizeof("SET non_pref_chan ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_SET_NON_PREF_CHAN;
+    if (strncmp(command, "AP_SCAN ", sizeof("AP_SCAN ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_AP_SCAN;
+    if (strncmp(command, "ENABLE_NETWORK ",
+                sizeof("ENABLE_NETWORK ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_ENABLE_NETWORK;
+    if (strncmp(command, "SET_NETWORK ", sizeof("SET_NETWORK ") - 1) != 0)
+        return BRIDGE_AP_COMMAND_OTHER;
+
+    setting = strchr(command + sizeof("SET_NETWORK ") - 1, ' ');
+    if (!setting || !setting[1])
+        return BRIDGE_AP_COMMAND_SET_NETWORK_GENERIC;
+    ++setting;
+    if (strncmp(setting, "key_mgmt ", sizeof("key_mgmt ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_SET_NETWORK_KEY_MGMT;
+    if (strncmp(setting, "mode ", sizeof("mode ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_SET_NETWORK_MODE;
+    if (strncmp(setting, "ssid ", sizeof("ssid ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_SET_NETWORK_SSID;
+    if (strncmp(setting, "psk ", sizeof("psk ") - 1) == 0)
+        return BRIDGE_AP_COMMAND_SET_NETWORK_PSK;
+    return BRIDGE_AP_COMMAND_SET_NETWORK_GENERIC;
+}
