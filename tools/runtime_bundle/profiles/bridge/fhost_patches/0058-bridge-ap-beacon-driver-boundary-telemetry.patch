+static int bridge_ap_start_beacon_active(const struct hostapd_data *hapd)
+{
+	return hapd && hapd->iface && hapd->conf &&
+		os_strcmp(hapd->conf->iface, "wl2") == 0;
+}
+
+static void bridge_ap_start_beacon(struct hostapd_data *hapd,
+				   uint8_t phase, int result,
+				   uint32_t detail0, uint32_t detail1)
+{
+	if (!bridge_ap_start_beacon_active(hapd))
+		return;
+
+	fhost_bridge_ap_start_hostapd_lifecycle(
+		phase, result, hapd->iface->state, hapd->iface->wait_channel_update,
+		detail0, detail1);
+}
+
 
