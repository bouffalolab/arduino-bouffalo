--- a/components/wireless/wifi6/wpa_supplicant/wpa_supplicant/wpa_supplicant.c
+++ b/components/wireless/wifi6/wpa_supplicant/wpa_supplicant/wpa_supplicant.c
@@ -4366,13 +4366,28 @@
 struct wpa_ssid * wpa_supplicant_add_network(struct wpa_supplicant *wpa_s)
 {
 	struct wpa_ssid *ssid;
+	const int bridge_ap_add_network = os_strcmp(wpa_s->ifname, "wl2") == 0;
 
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(177, 0);
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(178, 0);
 	ssid = wpa_config_add_network(wpa_s->conf);
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(179, ssid ? 0 : -1);
 	if (!ssid)
 		return NULL;
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(180, 0);
 	wpas_notify_network_added(wpa_s, ssid);
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(181, 0);
 	ssid->disabled = 1;
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(182, 0);
 	wpa_config_set_network_defaults(ssid);
+	if (bridge_ap_add_network)
+		fhost_bridge_ap_start_progress(183, 0);
 
 	return ssid;
 }
