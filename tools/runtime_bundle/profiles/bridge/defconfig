-include $(BL_SDK_BASE)/examples/wifi/defconfig

# Persist bridge state in the SDK's LittleFS/EasyFlash implementation.
CONFIG_BFLB_MTD              =y
CONFIG_PARTITION             =y
CONFIG_LITTLEFS              =y
CONFIG_LITTLEFS_KV_EASYFLASH =y

# The bridge needs a FreeRTOS USB device with CDC ACM and vendor HID.
CONFIG_BSP_USB                 =y
CONFIG_CHERRYUSB               =y
CONFIG_CHERRYUSB_DEVICE        =y
CONFIG_CHERRYUSB_DEVICE_CDC    =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM=y
CONFIG_CHERRYUSB_DEVICE_HID    =y

# Keep the Wi-Fi/BLE coexistence controller selected by the BL616CL SDK demo.
CONFIG_BLUETOOTH              =y
CONFIG_BT_SETTINGS            =y
CONFIG_BT_STACK_CLI           =n
CONFIG_BTBLECONTROLLER_LIB    =m2s1
CONFIG_BLE_USE_MAC2           =n

CONFIG_BFLB_LOG               =n
CONFIG_FREERTOS               =y
CONFIG_SHELL                  =n
CONFIG_RF                     =y
CONFIG_PEC_V2                 =n
CONFIG_MULTIMEDIA_VIDEO       =n
CONFIG_GCC_COMPILE_LTO        =n
CONFIG_TLSF                   =y
CONFIG_DEBUG                  =y
CONFIG_ROMAPI                 =y
CONFIG_LOG_LEVEL              =3
CONFIG_CONSOLE_UART_BAUDRATE  =2000000
