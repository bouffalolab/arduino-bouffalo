#include <WiFiS3.h>
#include <Modem.h>
#include <stdlib.h>
#include <string.h>
#include <string>

namespace {

constexpr unsigned long kWifiTimeoutMs = 30000UL;
constexpr unsigned long kIoTimeoutMs = 10000UL;
constexpr size_t kPayloadSize = 32U;
constexpr bool kExpectAbruptClose = @TLS_EXPECT_ABRUPT_CLOSE@;
constexpr bool kMixedClose = @TLS_MIXED_CLOSE@;
constexpr size_t kCloseRounds = @TLS_CLOSE_ROUNDS@U;

const char kTrustedCa[] =
@TLS_TRUSTED_CA_LITERAL@;

char command[240] = {};
size_t command_size = 0U;
bool finished = false;
WiFiSSLClient client;
uint8_t payload[kPayloadSize] = {};
uint8_t reply[kPayloadSize] = {};

void fail(const char *reason) {
  client.stop();
  WiFi.disconnect();
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:RESULT=FAIL:");
  Serial.println(reason);
  finished = true;
}

int hex_digit(char value) {
  if (value >= '0' && value <= '9') return value - '0';
  if (value >= 'a' && value <= 'f') return value - 'a' + 10;
  if (value >= 'A' && value <= 'F') return value - 'A' + 10;
  return -1;
}

bool decode_hex(char *field) {
  const size_t encoded = strlen(field);
  if (encoded == 0U || (encoded & 1U) != 0U) return false;
  for (size_t index = 0U; index < encoded / 2U; ++index) {
    const int high = hex_digit(field[index * 2U]);
    const int low = hex_digit(field[index * 2U + 1U]);
    if (high < 0 || low < 0) return false;
    field[index] = static_cast<char>((high << 4U) | low);
  }
  field[encoded / 2U] = '\0';
  return true;
}

bool parse_start(
    char *&ssid,
    char *&password,
    IPAddress &peer,
    uint16_t &port) {
  if (strncmp(command, "START ", 6U) != 0) return false;
  char *fields[4] = {command + 6U};
  for (size_t index = 1U; index < 4U; ++index) {
    fields[index] = strchr(fields[index - 1U], ' ');
    if (fields[index] == nullptr) return false;
    *fields[index]++ = '\0';
  }
  if (strchr(fields[3], ' ') != nullptr) return false;
  char *port_end = nullptr;
  const unsigned long parsed_port = strtoul(fields[3], &port_end, 10);
  ssid = fields[0];
  password = fields[1];
  if (!decode_hex(ssid) || !decode_hex(password) ||
      !peer.fromString(fields[2]) || port_end == fields[3] ||
      *port_end != '\0' || parsed_port == 0U || parsed_port > 65535U) {
    return false;
  }
  port = static_cast<uint16_t>(parsed_port);
  return true;
}

bool wait_station() {
  const unsigned long started_at = millis();
  while (WiFi.status() != WL_CONNECTED) {
    if (millis() - started_at >= kWifiTimeoutMs) return false;
    delay(20);
  }
  return true;
}

bool read_exact(size_t size) {
  size_t received = 0U;
  const unsigned long started_at = millis();
  while (received < size && millis() - started_at < kIoTimeoutMs) {
    const int count = client.read(reply + received, size - received);
    if (count > 0) {
      received += static_cast<size_t>(count);
    } else {
      delay(10);
    }
  }
  return received == size;
}

bool print_diagnostic(const char *stage, int socket = 2000) {
  std::string response;
  modem.begin();
  if (!modem.write(
          "+SSLCLIENTDIAG:", response, "AT+SSLCLIENTDIAG=%d\r\n", socket)) {
    return false;
  }
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:");
  Serial.print(stage);
  Serial.print("_DIAG=");
  Serial.println(response.c_str());
  return true;
}

bool sample_idle_heap() {
  // A fresh, unconnected slot exposes the existing live-heap diagnostic.
  std::string response;
  modem.begin();
  if (!modem.write("+SSLBEGINCLIENT:", response, "AT+SSLBEGINCLIENT\r\n")) {
    return false;
  }
  const int socket = atoi(response.c_str());
  const bool sampled = socket == 2000 && print_diagnostic("IDLE", socket);
  modem.begin();
  const bool closed = modem.write(
      "+SSLCLIENTCLOSE:", response, "AT+SSLCLIENTCLOSE=%d\r\n", socket);
  return sampled && closed;
}

void run_cycle(IPAddress peer, uint16_t port, size_t cycle) {
  const unsigned long started_at = millis();
  const bool abrupt = kMixedClose ? (cycle - 1U) % 3U != 0U : kExpectAbruptClose;
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:CYCLE_START=");
  Serial.println(static_cast<unsigned long>(cycle));

  for (size_t index = 0U; index < sizeof(payload); ++index) {
    payload[index] = static_cast<uint8_t>(0x70U + index + cycle - 1U);
  }
  client.setCACert(kTrustedCa);
  client.setConnectionTimeout(kIoTimeoutMs);
  if (client.connect(peer, port) != 1) {
    fail("FIRST_CONNECT");
    return;
  }
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:FIRST_HANDSHAKE_PASS");
  if (kCloseRounds > 1U && !print_diagnostic("FIRST")) {
    fail("FIRST_DIAG");
    return;
  }
  if (client.write(payload, sizeof(payload)) != sizeof(payload) ||
      !read_exact(sizeof(reply)) ||
      memcmp(reply, payload, sizeof(reply)) != 0) {
    fail("FIRST_ECHO");
    return;
  }
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:FIRST_ECHO_PASS");

  if (abrupt) {
    if (!read_exact(sizeof(reply))) {
      fail("TAIL_READ");
      return;
    }
    for (size_t index = 0U; index < sizeof(reply); ++index) {
      if (reply[index] != static_cast<uint8_t>(payload[index] ^ 0xFFU)) {
        fail("TAIL_DATA");
        return;
      }
    }
    Serial.println("RA4_TLS_GRACEFUL_CLOSE:TAIL_DATA_PASS");
  }

  const unsigned long close_started_at = millis();
  int connected_after_close = 1;
  int available_after_close = -1;
  int read_after_close = -2;
  while (millis() - close_started_at < kIoTimeoutMs) {
    connected_after_close = client.connected() ? 1 : 0;
    available_after_close = client.available();
    if (connected_after_close == 0 && available_after_close == 0) {
      read_after_close = client.read();
      break;
    }
    delay(10);
  }
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:CONNECTED_AFTER_CLOSE=");
  Serial.println(connected_after_close);
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:AVAILABLE_AFTER_CLOSE=");
  Serial.println(available_after_close);
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:READ_AFTER_CLOSE=");
  Serial.println(read_after_close);
  if (connected_after_close != 0 || available_after_close != 0 ||
      read_after_close >= 0) {
    fail("CLOSE_STATE");
    return;
  }
  Serial.println(abrupt
      ? "RA4_TLS_GRACEFUL_CLOSE:BARE_FIN_PASS"
      : "RA4_TLS_GRACEFUL_CLOSE:CLOSE_NOTIFY_PASS");

  const size_t failed_write = client.write(payload, sizeof(payload));
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:WRITE_AFTER_CLOSE=");
  Serial.println(static_cast<unsigned long>(failed_write));
  if (failed_write != 0U) {
    fail("CLOSE_WRITE");
    return;
  }
  client.stop();
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:CLOSE_PASS");

  client.setCACert(kTrustedCa);
  client.setConnectionTimeout(kIoTimeoutMs);
  if (client.connect(peer, port) != 1) {
    fail("RECOVERY_CONNECT");
    return;
  }
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:RECOVERY_HANDSHAKE_PASS");
  if (kCloseRounds > 1U && !print_diagnostic("RECOVERY")) {
    fail("RECOVERY_DIAG");
    return;
  }
  if (client.write(payload, sizeof(payload)) != sizeof(payload) ||
      !read_exact(sizeof(reply)) ||
      memcmp(reply, payload, sizeof(reply)) != 0) {
    fail("RECOVERY_ECHO");
    return;
  }
  client.stop();
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:RECOVERY_ECHO_PASS");
  if (kCloseRounds > 1U && !sample_idle_heap()) {
    fail("IDLE_DIAG");
    return;
  }
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:CYCLE_ELAPSED_MS=");
  Serial.println(millis() - started_at);
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:CYCLE_PASS=");
  Serial.println(static_cast<unsigned long>(cycle));
}

void run_gate() {
  char *ssid = nullptr;
  char *password = nullptr;
  IPAddress peer;
  uint16_t port = 0U;
  if (!parse_start(ssid, password, peer, port)) {
    fail("START");
    return;
  }
  WiFi.setTimeout(kWifiTimeoutMs);
  if (WiFi.begin(ssid, password) != WL_CONNECTED && !wait_station()) {
    fail("WIFI");
    return;
  }
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:WIFI_CONNECTED");
  const unsigned long started_at = millis();
  for (size_t cycle = 1U; cycle <= kCloseRounds; ++cycle) {
    run_cycle(peer, port, cycle);
    if (finished) return;
  }
  WiFi.disconnect();
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:ELAPSED_MS=");
  Serial.println(millis() - started_at);
  Serial.print("RA4_TLS_GRACEFUL_CLOSE:HANDSHAKES_PASS=");
  Serial.println(static_cast<unsigned long>(kCloseRounds * 2U));
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:RESULT=PASS");
  finished = true;
}

}  // namespace

void setup() {
  Serial.begin(115200);
  Serial.println("RA4_TLS_GRACEFUL_CLOSE:READY");
}

void loop() {
  if (finished) {
    delay(10);
    return;
  }
  static unsigned long last_ready = millis();
  if (millis() - last_ready >= 1000UL) {
    Serial.println("RA4_TLS_GRACEFUL_CLOSE:READY");
    last_ready = millis();
  }
  while (Serial.available() > 0) {
    const int value = Serial.read();
    if (value == '\r') continue;
    if (value == '\n') {
      command[command_size] = '\0';
      command_size = 0U;
      run_gate();
      return;
    }
    if (value < 0 || command_size + 1U >= sizeof(command)) {
      fail("COMMAND");
      return;
    }
    command[command_size++] = static_cast<char>(value);
  }
}
