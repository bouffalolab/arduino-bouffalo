# Toolchain and host tools — regenerated by generate_runtime_bundle.py.
# Each developer points to their own toolchain; the script copies a minimal
# subset into the platform.  Committing 300+ MB of binaries is unnecessary.
tools/Xuantie-900-gcc/
tools/Xuantie-900-gcc-zephyr/
tools/bflb_fw_post_proc/
tools/bouffalo_flash_cube/

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Temporary build directory created by generate_runtime_bundle.py
tools/runtime_bundle/build/

# Arduino CLI build output (compile-bl616cl-stage1.sh etc.)
build/

# OS junk
.DS_Store
Thumbs.db
*~
